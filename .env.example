# Supabase — copie para .env.local e preencha com as chaves reais
# NUNCA commite o .env.local

# Públicas (expostas ao browser, seguras com RLS ativo)
NEXT_PUBLIC_SUPABASE_URL=https://xvzvqtcesntnrwuhckqu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secreta (somente servidor — service role, ignora RLS). NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# URL base do app (para gerar links públicos de aprovação e links nos emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notificações por email (Resend). Deixe RESEND_API_KEY vazio para desativar
# o envio (o app loga no console em vez de enviar).
RESEND_API_KEY=
# Remetente verificado no Resend. Em testes pode usar "Bússola <onboarding@resend.dev>".
EMAIL_FROM=Bússola <onboarding@resend.dev>
